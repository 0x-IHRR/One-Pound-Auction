DATABASE_URL="file:./dev.db"
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-local-dev-secret
AUTH_DEMO_ENABLED=true
AUTH_DEMO_USER_EMAIL=demo-user@example.com
AUTH_DEMO_USER_NAME=Demo Buyer
AUTH_DEMO_ADMIN_EMAIL=demo-admin@example.com
AUTH_DEMO_ADMIN_NAME=Demo Admin
# Google OAuth（公网 MVP 推荐开启）
# 本地回调地址：http://localhost:3000/api/auth/callback/google
# 生产回调地址：https://your-domain.com/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_ADMIN_EMAILS=demo-admin@example.com
